# Inventaire documentaire des variables attendues en production/staging - jamais chargé
# par Compose (aucun "--env-file .env.prod.example" nulle part), jamais de valeur réelle
# ici. Depuis la Phase D3, aucun fichier ".env.production"/".env.staging" ne doit exister
# sur le serveur : ces valeurs sont injectées au moment du déploiement par
# "infisical run --projectId=... --env=<env> -- docker compose ... up -d"
# (docker/deploy/ssh-deploy.sh, dépôts bec-backend/bec-frontend), jamais écrites sur disque.

# Domaine public du routeur Traefik (docker-compose.prod.traefik.yml, jamais committé).
PUBLIC_DOMAIN=cobage.joeltech.fr

# Images GHCR taguées par SHA court - jamais "latest", jamais un placeholder oublié
# (pull_policy: always fait échouer bruyamment un déploiement si l'image n'existe pas sur
# le registre, plutôt que de réutiliser silencieusement une vieille image en cache local).
BACKEND_IMAGE=ghcr.io/joello61/bec-back:REMPLACER_PAR_LE_SHA
FRONTEND_IMAGE=ghcr.io/joello61/bec-front:REMPLACER_PAR_LE_SHA

# Secret Symfony (kernel.secret) et passphrase de génération des clés JWT (Phase 1 du plan
# de correction - valeurs régénérées, jamais celles trouvées dans l'historique Git).
APP_SECRET=
JWT_PASSPHRASE=

# Base de données.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# CORS - regex d'origine correspondant à PUBLIC_DOMAIN, jamais un wildcard combiné à
# allow_credentials (CLAUDE.md section 10).
CORS_ALLOW_ORIGIN=
FRONTEND_URL=https://cobage.joeltech.fr

# Mailer - Brevo en relais SMTP générique, aucune nouvelle dépendance (symfony/mailer gère
# nativement le schéma smtp://, décision actée le 2026-09-09).
MAILER_DSN=smtp://REMPLACER@smtp-relay.brevo.com:587
MAILER_FROM=no-reply@cobage.joeltech.fr

# Mercure (temps réel) - hub de production, distinct du hub de dev (bec-infra/
# docker-compose.yml). MERCURE_PUBLIC_URL est l'URL vue par le navigateur (via le
# nginx-pont, /.well-known/mercure) - jamais un accès direct au conteneur "mercure".
MERCURE_PUBLIC_URL=https://cobage.joeltech.fr/.well-known/mercure
MERCURE_JWT_SECRET=
MERCURE_SUBSCRIBER_JWT_KEY=

# Phase D1 - scrapé par Prometheus (infrastructure partagée du VPS), aligné avec
# secrets/metrics_scrape_token_cobage côté dépôt infrastructure (Phase D5).
METRICS_SCRAPE_TOKEN=
# Endpoint OTLP HTTP du collecteur Tempo (infrastructure partagée du VPS).
TEMPO_OTLP_ENDPOINT=http://tempo:4318

# Monetisation (Stripe - abonnements carte + boost one-time). Price Stripe (mode
# recurring) a creer manuellement dans le Dashboard Stripe pour les plans payants avant
# de renseigner les deux ID ci-dessous. Voir bec-docs/docs/monetisation/monetisation-cobage.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=

# Monetisation (Notch Pay - Mobile Money Cameroun). NOTCHPAY_PRIVATE_KEY est distincte
# de la cle secrete, exigee uniquement par l'API de remboursement (Lot 6.1). Jamais testees
# contre un compte sandbox reel avant mise en production - cf. monetisation-cobage.md §6.
NOTCHPAY_SECRET_KEY=
NOTCHPAY_WEBHOOK_SECRET=
NOTCHPAY_PRIVATE_KEY=

# Phase D1 - stockage des avatars (Flysystem, adaptateur S3 compatible Cloudflare R2).
# R2_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com (jamais l'URL publique du
# bucket, qui est R2_PUBLIC_URL ci-dessous - deux URLs distinctes, deux usages distincts).
R2_ENDPOINT=https://REMPLACER.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://REMPLACER.r2.dev

# OAuth - redirect URIs pointées sur le domaine public réel, jamais localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cobage.joeltech.fr/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://cobage.joeltech.fr/api/auth/facebook/callback

# Twilio (SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Taux de change.
EXCHANGE_RATE_API_KEY=

# Frontend - injectées au BUILD par la CI (bec-frontend/.github/workflows/deploy.yml),
# jamais au runtime serveur (NEXT_PUBLIC_* est inliné dans le bundle client au moment de
# "next build"). Un seul domaine pour tout (frontend + API), routé par chemin via le
# nginx-pont (/api/ -> backend, / -> frontend) - même origine qu'en dev (localhost:8000),
# jamais un sous-domaine "cobage-api" séparé (écart trouvé : next.config.ts référençait
# encore ce sous-domaine pour les avatars, obsolète depuis la bascule vers R2 - Phase D1/D2,
# à corriger dans bec-frontend).
NEXT_PUBLIC_API_URL=https://cobage.joeltech.fr/api
NEXT_PUBLIC_APP_URL=https://cobage.joeltech.fr
NEXT_PUBLIC_API_DOMAIN=https://cobage.joeltech.fr
NEXT_PUBLIC_MERCURE_HUB_URL=https://cobage.joeltech.fr/.well-known/mercure
